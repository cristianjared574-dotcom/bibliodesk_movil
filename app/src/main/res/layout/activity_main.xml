<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    tools:context=".Vista.MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="#7B1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgLogoInicio"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Logo BiblioDesk"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo" />

        <TextView
            android:id="@+id/txtNombreSistema"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="BiblioDesk"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAumentarTexto"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="A+"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FFF9EE"
            app:cornerRadius="5dp"
            app:strokeColor="#D4A72C"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisminuirTexto"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:layout_marginEnd="4dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="A−"
            android:textAllCaps="false"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#FFF9EE"
            app:cornerRadius="5dp"
            app:strokeColor="#D4A72C"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccesibilidad"
            android:layout_width="38dp"
            android:layout_height="34dp"
            android:contentDescription="Accesibilidad"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="6dp"
            app:backgroundTint="#FFF9EE"
            app:cornerRadius="5dp"
            app:icon="@drawable/ic_lectura_voz"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="#111111"
            app:strokeColor="#D4A72C"
            app:strokeWidth="1dp" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollInicio"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FAF7F2"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/menuInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linearLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/txtSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#7B1E1E"
                android:textSize="19sp"
                android:textStyle="bold"
                tools:text="¡Hola, Alejandro!" />

            <TextView
                android:id="@+id/txtBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Bienvenido a tu biblioteca digital"
                android:textColor="#302925"
                android:textSize="15sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:layout_marginTop="9dp">

                <ImageView
                    android:id="@+id/imgBiblioteca"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Biblioteca"
                    android:scaleType="centerCrop"
                    android:src="@drawable/biblioteca_inicio" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="30dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explora nuestro&#10;catálogo"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVerCatalogo"
                        android:layout_width="170dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Ver catálogo"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="#8F1F1F"
                        app:cornerRadius="5dp"
                        app:strokeColor="#D4A72C"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrestamoActual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="150dp"
                app:cardBackgroundColor="#F5E8CB"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/txtTituloPrestamo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Préstamo actual"
                        android:textColor="#7B1E1E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/imgPortadaPrestamo"
                            android:layout_width="76dp"
                            android:layout_height="106dp"
                            android:contentDescription="Portada del libro"
                            android:scaleType="centerCrop"
                            android:src="@drawable/logo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtTituloLibro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="#111111"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="El Principito" />

                            <TextView
                                android:id="@+id/txtAutorLibro"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#4A413C"
                                android:textSize="13sp"
                                tools:text="Antoine de Saint-Exupéry" />

                            <TextView
                                android:id="@+id/txtFechaLimite"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textColor="#302925"
                                android:textSize="14sp"
                                tools:text="17 noviembre 2026" />

                            <TextView
                                android:id="@+id/txtEstadoPrestamo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="#7B1E1E"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:text="ATRASADO" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnVerPrestamo"
                                android:layout_width="145dp"
                                android:layout_height="38dp"
                                android:layout_marginTop="6dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Ver Préstamo"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="#8F1F1F"
                                app:cornerRadius="5dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtSinPrestamos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#F5E8CB"
                android:gravity="center"
                android:padding="12dp"
                android:text="No tienes préstamos en curso"
                android:textColor="#4A413C"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBiblioteca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                app:cardBackgroundColor="#F5E8CB"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="9dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sobre la biblioteca"
                        android:textColor="#7B1E1E"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:text="Servicios, noticias y eventos bibliotecarios"
                        android:textColor="#302925"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPaginaOficial"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="7dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Visitar página oficial"
                        android:textAllCaps="false"
                        android:textColor="#7B1E1E"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFF9EE"
                        app:cornerRadius="5dp"
                        app:strokeColor="#7B1E1E"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/menuInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_menu"
        android:paddingBottom="0dp"
        app:itemActiveIndicatorStyle="@style/IndicadorMenu"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/color_menu"
        app:itemPaddingBottom="4dp"
        app:itemTextColor="@color/color_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_inferior" />

</androidx.constraintlayout.widget.ConstraintLayout>