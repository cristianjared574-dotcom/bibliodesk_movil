<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    tools:context=".Vista.DetalleLibroActivity">

    <LinearLayout
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#7B1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            app:srcCompat="@drawable/ic_regresar" />

        <TextView
            android:id="@+id/txtSeccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:text="Detalle del libro"
            android:textColor="#F8F8F8"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior"
        app:layout_constraintBottom_toTopOf="@id/menuInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAF7F2"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivPortada"
                    android:layout_width="100dp"
                    android:layout_height="140dp"
                    android:scaleType="centerCrop"
                    android:background="#E0E0E0"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp">

                    <TextView
                        android:id="@+id/txtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:text="Textview"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtAutor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="14sp"
                        android:text="Textview"
                        android:textColor="#75685E"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/txtCategoria"
                        android:layout_width="213dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:background="#ECE0E0"
                        android:paddingStart="8dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="2dp"
                        android:text="Textview"
                        android:textColor="#7B1E1E"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Descripción"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#7B1E1E"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#424242"
                android:text="Textview"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Información bibliográfica"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#7B1E1E"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txtIsbn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:text="Textview"
                android:textColor="#424242"
                android:drawablePadding="8dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtEditorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:text="Textview"
                android:textColor="#424242"
                android:drawablePadding="8dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtAnio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:text="Textview"
                android:textColor="#424242"
                android:drawablePadding="8dp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtPaginas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:text="Textview"
                android:textColor="#424242"
                android:drawablePadding="8dp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnLeerTexto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#F5F5F5"
                android:shadowColor="#673AB7"
                android:text="Leer texto"
                android:textColor="#7B1E1E"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="4dp"
                app:strokeColor="#7B1E1E"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btnDisponibilidad"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#7B1E1E"
                android:text="Solicitar Préstamo"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="4dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/menuInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_menu"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/color_menu"
        app:itemTextColor="@color/color_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_inferior"/>

</androidx.constraintlayout.widget.ConstraintLayout>
